rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Put YOUR admin email here (lowercase) – same as ADMIN_EMAIL in js/config.js
    function adminEmail() { return 'your.email@gmail.com'; }

    function myEmail()  { return request.auth.token.email.lower(); }
    function isAdmin()  { return request.auth != null && myEmail() == adminEmail(); }
    function memberDoc() { return /databases/$(database)/documents/members/$(myEmail()); }
    // Only people the admin added (and not disabled) can use the site
    function isMember() { return request.auth != null && (isAdmin() || (exists(memberDoc()) && get(memberDoc()).data.active == true)); }
    function owner()    { return resource.data.uid == request.auth.uid; }
    function newOwner() { return request.resource.data.uid == request.auth.uid; }

    // Members list (doc id = email). Only the admin adds / disables people. A member may only touch lastSeen / uid / the first-login flag.
    match /members/{email} {
      allow read: if isMember() || (request.auth != null && myEmail() == email);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isMember() && myEmail() == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'uid', 'mustChangePassword'])
        && request.resource.data.uid == request.auth.uid
        && (!('mustChangePassword' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.mustChangePassword == false));
    }
    // Topic status: everyone reads, only the owner writes
    match /progress/{uid} { allow read: if isMember(); allow write: if isMember() && request.auth.uid == uid; }

    // Admin-managed content
    match /notices/{id}   { allow read: if isMember(); allow write: if isAdmin(); }
    match /questions/{id} { allow read: if isMember(); allow write: if isAdmin(); }                       // question text + options (no answers)
    match /answerKeys/{id} { allow get: if isMember(); allow list, write: if isAdmin(); }                  // answers + explanations: one at a time, cannot be listed
    match /qindex/{id}    { allow read: if isMember(); allow write: if isAdmin(); }                       // tiny per-subject index used to pick random questions
    match /papers/{id}    { allow read: if isMember(); allow write: if isAdmin(); }

    // A student's own data (the admin may read; the admin may also fix scores after correcting an answer key)
    match /attempts/{id} {
      allow read: if isMember() && (owner() || isAdmin());
      allow create: if isMember() && newOwner() && request.resource.data.status == 'running';
      allow update: if isMember() && ((owner() && newOwner() && resource.data.status == 'running') || isAdmin());
      allow delete: if isMember() && (owner() || isAdmin());
    }
    match /mistakes/{id}  { allow read: if isMember() && (owner() || isAdmin()); allow create: if isMember() && newOwner(); allow update, delete: if isMember() && owner(); }
    match /bookmarks/{id} { allow read: if isMember() && (owner() || isAdmin()); allow create: if isMember() && newOwner(); allow update, delete: if isMember() && owner(); }

    // "Report this question": members create; everyone can see open reports (so reported questions are skipped in new tests); only the admin resolves them
    match /reports/{id} { allow read: if isMember(); allow create: if isMember() && newOwner(); allow update, delete: if isAdmin(); }

    // Shared: members read / add; the creator edits or deletes; the admin can moderate
    match /{col}/{id} {
      allow read: if isMember() && col in ['resources', 'drives', 'logs'];
      allow create: if isMember() && col in ['resources', 'drives', 'logs'] && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isMember() && col in ['resources', 'drives', 'logs'] && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
