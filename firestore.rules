rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Put YOUR admin email here (lowercase) – same as ADMIN_EMAIL in js/config.js
    function adminEmail() { return 'your.email@gmail.com'; }

    function myEmail()  { return request.auth.token.email.lower(); }
    function isAdmin()  { return request.auth != null && myEmail() == adminEmail(); }
    function memberDoc() { return /databases/$(database)/documents/members/$(myEmail()); }
    // Only people the admin added (and not disabled) can use the site
    function isMember() {
      return request.auth != null && (isAdmin() ||
        (exists(memberDoc()) && get(memberDoc()).data.active == true));
    }
    function owner() { return resource.data.uid == request.auth.uid; }
    function newOwner() { return request.resource.data.uid == request.auth.uid; }

    // ---------- members / progress / notices (unchanged) ----------
    match /members/{email} {
      allow read: if isMember() || (request.auth != null && myEmail() == email);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isMember() && myEmail() == email
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastSeen', 'uid', 'mustChangePassword', 'pwChangedAt'])
        && request.resource.data.uid == request.auth.uid
        && (!('mustChangePassword' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.mustChangePassword == false)
      );
    }
    match /progress/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }
    match /notices/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // ---------- NEW: question bank & tests ----------
    // Questions (text + options, NO answers): members read, only admin writes
    match /questions/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // Answer keys + explanations: members can fetch ONE doc at a time (get), cannot list/browse the collection
    match /answerKeys/{id} {
      allow get: if isMember();
      allow list, write: if isAdmin();
    }
    // Light-weight search index (ids + topic + difficulty) used to build random tests cheaply
    match /qindex/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // Tests created by admin
    match /tests/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // A student's attempts: private to them (admin can read). Locked once submitted.
    match /attempts/{id} {
      allow read: if isMember() && (owner() || isAdmin());
      allow create: if isMember() && newOwner() && request.resource.data.status == 'running';
      allow update: if isMember() && owner() && newOwner() && resource.data.status == 'running';
      allow delete: if isMember() && (owner() || isAdmin());
    }
    // Personal notebook: wrong-question list + starred questions (private)
    match /mistakes/{id} {
      allow read: if isMember() && (owner() || isAdmin());
      allow create: if isMember() && newOwner();
      allow update, delete: if isMember() && owner();
    }
    match /bookmarks/{id} {
      allow read: if isMember() && (owner() || isAdmin());
      allow create: if isMember() && newOwner();
      allow update, delete: if isMember() && owner();
    }
    // "Report this question": members create, only admin reads/resolves
    match /reports/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isMember() && newOwner();
    }

    // ---------- shared collections (unchanged): members read/add; creator edits/deletes; admin can moderate ----------
    match /{col}/{id} {
      allow read: if isMember() && col in ['resources', 'drives', 'logs', 'mocks', 'comments', 'activity'];
      allow create: if isMember()
        && col in ['resources', 'drives', 'logs', 'mocks', 'comments', 'activity']
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isMember()
        && col in ['resources', 'drives', 'logs', 'mocks', 'comments', 'activity']
        && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
